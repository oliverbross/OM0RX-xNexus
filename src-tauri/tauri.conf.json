{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "OM0RX-xNexus",
  "mainBinaryName": "OM0RX-xNexus",
  "version": "1.25.0-xlog.19",
  "identifier": "sk.om0rx.xnexus",
  "build": {
    "frontendDist": "../ui/dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "npm --prefix ui run dev",
    "beforeBuildCommand": "npm --prefix ui run build"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "OM0RX-xNexus",
        "label": "main",
        "url": "blank.html",
        "width": 1200,
        "height": 720,
        "minWidth": 900,
        "minHeight": 600,
        "resizable": true,
        "fullscreen": false,
        "center": true,
        "visible": false,
        "dragDropEnabled": false
      },
      {
        "label": "splashscreen",
        "url": "splashscreen.html",
        "width": 960,
        "height": 540,
        "decorations": false,
        "resizable": false,
        "center": true,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "shadow": false
      }
    ],
    "security": {
      "csp": null,
      "assetProtocol": {
        "enable": true,
        "scope": [
          "$PICTURE/OM0RX-xNexus SSTV/**",
          "$LOCALDATA/OM0RX-xNexus/sstv-gallery/**"
        ]
      }
    }
  },
  "bundle": {
    "active": true,
    "createUpdaterArtifacts": false,
    "targets": "all",
    "category": "Utility",
    "publisher": "OM0RX",
    "copyright": "Copyright (C) 2026 KD9TAW and OM0RX. GPL-3.0-only.",
    "shortDescription": "Nexus for the OM0RX station, beside OM0RX-xLog",
    "longDescription": "OM0RX-xNexus is full Nexus with its own name, data folders and version, plus CS and DS status columns from your own log. It works beside OM0RX-xLog, reporting logged contacts over the WSJT-X UDP API and accepting new xLog contacts on its contact port.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": {
      "resources/hamlib/*": "resources/hamlib/",
      "resources/deepcw/*": "resources/deepcw/",
      "resources/tles/*": "resources/tles/",
      "resources/iota/*": "resources/iota/",
      "../libtempo/vendor/wsjtx/ALLCALL7.TXT": "resources/ft8var/ALLCALL7.TXT",
      "../licenses/remote/*": "resources/remote/",
      "../licenses/stream/*": "resources/stream/",
      "../licenses/openssl/*": "resources/openssl/",
      "../licenses/ui/*": "resources/ui/",
      "../licenses/rust/THIRD-PARTY.txt": "resources/rust/THIRD-PARTY.txt",
      "../COPYING": "COPYING",
      "../NOTICE": "NOTICE"
    },
    "windows": {
      "webviewInstallMode": {
        "type": "offlineInstaller",
        "silent": false
      },
      "nsis": {
        "installMode": "currentUser",
        "displayLanguageSelector": true,
        "languages": [
          "English",
          "Italian",
          "German",
          "French",
          "Spanish",
          "Portuguese",
          "Dutch",
          "Japanese"
        ]
      }
    },
    "linux": {
      "deb": {
        "depends": [
          "libhamlib-utils",
          "libgfortran5",
          "libfftw3-single3",
          "libssl3"
        ]
      }
    },
    "macOS": {
      "entitlements": "Entitlements.plist",
      "minimumSystemVersion": "12.0"
    }
  },
  "plugins": {}
}
